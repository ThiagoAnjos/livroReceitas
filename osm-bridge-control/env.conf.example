# env.conf.example
#
# Copie este arquivo para "env.conf" (mesmo diretorio) e ajuste os valores
# para o seu ambiente. O arquivo env.conf NAO deve ser versionado (contem
# caminhos especificos do ambiente e referencias as credenciais).

# Diretorio do WLST nativo do WebLogic 12c usado pelo Oracle OSM.
# Geralmente: $ORACLE_HOME/oracle_common/common/bin  (FMW 12c)
WLST_HOME="/u01/oracle/middleware/oracle_common/common/bin"

# URL t3 do AdminServer do dominio WebLogic do OSM
ADMIN_URL="t3://osm-admin.exemplo.com:7001"

# Arquivos gerados por storeUserConfig()/storeKey() (ver README.md).
# NUNCA armazene usuario/senha em texto plano neste arquivo.
WLS_USER_CONFIG_FILE="/u01/oracle/security/osm.uc"
WLS_USER_KEY_FILE="/u01/oracle/security/osm.key"
